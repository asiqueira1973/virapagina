{
  "name": "virapagina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emu": "firebase emulators:start --project virapagina-local --only firestore,storage",
    "test:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 STORAGE_EMULATOR_HOST=http://127.0.0.1:9199 FIREBASE_PROJECT_ID=virapagina-local FIREBASE_STORAGE_BUCKET=virapagina-local.firebasestorage.app vitest run tests/firestore-emulador.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^6.3.289",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pageflip": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
