# Variáveis de ambiente do Virapágina (spec seção 18).
# Copie para .env.local no desenvolvimento e configure as mesmas na Vercel.
# O passo a passo de onde obter cada uma está no README.md.

# ---------------------------------------------------------------------------
# Desenvolvimento local: contra o EMULADOR do Firebase, sem credencial nenhuma.
# Suba o emulador com `npm run emu` e deixe as três linhas abaixo descomentadas.
# Para falar com o Firebase de verdade, comente-as e preencha a seção seguinte.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=virapagina-local
FIREBASE_STORAGE_BUCKET=virapagina-local.firebasestorage.app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# ---------------------------------------------------------------------------
# Firebase de verdade (produção e homologação)
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=

# Conta de serviço do Admin SDK.
# FIREBASE_CLIENT_EMAIL=

# SEGREDO. A credencial mais sensível do projeto: dá acesso total aos dados e
# aos arquivos. Nunca commitar, nunca logar, nunca expor ao cliente.
# Mantenha as quebras de linha como \n, entre aspas.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Login com Google (Auth.js)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Assina o cookie de sessão. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL do deploy. Em desenvolvimento: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Plataforma
# ---------------------------------------------------------------------------
# Admins da plataforma, separados por vírgula. Estas contas também nascem com
# plano ilimitado e se corrigem sozinhas a cada login (regra 11.13).
ADMIN_ALLOWED_EMAILS=

# Aparece nos termos, na privacidade, no canal de denúncia e no botão
# "Falar com a gente".
EMAIL_CONTATO=alexandre@dablab.com.br

# Enquanto for true, toda conta NOVA nasce early adopter: livros ilimitados,
# para sempre (regra 11.14). Desligar não rebaixa ninguém que já entrou —
# só muda quem entra a partir dali. Exige refazer o deploy na Vercel.
EARLY_ADOPTER_ABERTO=true

# Protege a rotina diária de aviso de tráfego (seção 13.4).
CRON_SECRET=
