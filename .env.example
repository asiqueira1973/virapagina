# Variáveis de PRODUÇÃO do Virapágina — é isto que vai na Vercel.
#
# Não há nada de emulador aqui de propósito: as variáveis de emulador vivem em
# `.env.development`, que só o desenvolvimento local carrega. Colar emulador em
# produção faz o site tentar falar com 127.0.0.1 (o código ignora e grita no
# log, mas a configuração continua errada).
#
# Para rodar localmente você NÃO precisa copiar este arquivo: `npm run dev` já
# funciona contra o emulador.

# --- Firebase: projeto e bucket (console → Configurações do projeto) ---
FIREBASE_PROJECT_ID=vira-pagina
FIREBASE_STORAGE_BUCKET=vira-pagina.firebasestorage.app

# --- Firebase: conta de serviço ---
# Console do Firebase → Configurações do projeto → Contas de serviço →
# "Gerar nova chave privada". Baixa um .json; os dois valores abaixo saem dele.
FIREBASE_CLIENT_EMAIL=
# SEGREDO. O campo `private_key` do JSON, incluindo as linhas BEGIN/END.
# Cole com os \n literais OU com as quebras de linha reais: os dois funcionam.
# Não inclua as aspas que existem no JSON.
FIREBASE_PRIVATE_KEY=

# --- Login com Google (Google Cloud → Credenciais → ID do cliente OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# O client do tipo **iOS**, para o app de iPhone. É OUTRO id que o de cima, e não
# tem segredo — é assim que o Google faz app nativo. Sem ele, /api/app/sessao
# recusa todo login vindo do app (spec-ios seção 3).
GOOGLE_OAUTH_IOS_CLIENT_ID=

# --- Sessão ---
# SEGREDO. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# A URL canônica do site. NÃO pode ficar vazia, e precisa do https://
NEXTAUTH_URL=https://virapagina.app.br

# --- Plataforma ---
ADMIN_ALLOWED_EMAILS=alexandre.silva.siqueira@gmail.com,alexandre@dablab.com.br,alexandre.siqueira@outlook.com
EMAIL_CONTATO=alexandre@dablab.com.br
# true enquanto toda conta nova nascer com livros ilimitados, para sempre.
EARLY_ADOPTER_ABERTO=true
# SEGREDO. Protege a rotina diária de tráfego. Gere com: openssl rand -base64 32
CRON_SECRET=

# --- App de iPhone (spec-ios) ---
# O bundle id do app. JWS de assinatura com outro bundle é de outro aplicativo e
# é recusado. Só mude se o bundle mudar na App Store Connect.
APP_STORE_BUNDLE_ID=app.br.virapagina.ios
