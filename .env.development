# Desenvolvimento local — VERSIONADO de propósito, e sem nenhum segredo.
#
# O Next carrega este arquivo só quando NODE_ENV=development, então nada daqui
# entra num build de produção. `npm run dev` funciona sem você copiar nada.
#
# Para sobrescrever qualquer valor na sua máquina, crie um `.env.local` — ele
# tem prioridade sobre este e não é versionado.

# Aponta o Admin SDK para o emulador (`npm run emu`), sem exigir credencial.
FIREBASE_PROJECT_ID=virapagina-local
FIREBASE_STORAGE_BUCKET=virapagina-local.firebasestorage.app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=desenvolvimento-local-nao-usar-em-producao

# O login com Google não funciona com estes valores: para exercitar o painel,
# ponha um OAuth Client de teste num `.env.local`.
GOOGLE_OAUTH_CLIENT_ID=placeholder
GOOGLE_OAUTH_CLIENT_SECRET=placeholder

ADMIN_ALLOWED_EMAILS=alexandre.silva.siqueira@gmail.com,alexandre@dablab.com.br,alexandre.siqueira@outlook.com
EMAIL_CONTATO=alexandre@dablab.com.br
EARLY_ADOPTER_ABERTO=true
CRON_SECRET=desenvolvimento-local
